rules_version = '2';

// Only signed-in users with a verified @bu.edu Google account can read or write pods.
// - Create: the creator must be the host and the only member.
// - Update: a user may add or remove only themselves in members. Joining stops at capacity and
//   10 minutes before the end. The host can't leave.
// - Cancel: only the host, only canceled going from false to true, and only before the pod ends.
// - Delete: never. Hosts cancel instead, which keeps the pod on record.
//
// Field names and limits must match PodFields in FirestorePodMapping.kt, the limits in CreatePodForm.kt,
// and JOIN_CUTOFF and MEMBER_NAME_MAX in Pod.kt.
service cloud.firestore {
  match /databases/{database}/documents {

    match /pods/{podId} {
      allow read: if isBuUser();
      allow create: if isBuUser() && podId.size() <= 64 && isValidNewPod(request.resource.data);
      allow update: if isBuUser() && (isJoin(resource.data, request.resource.data)
                                       || isLeave(resource.data, request.resource.data)
                                       || isCancel(resource.data, request.resource.data));
      allow delete: if false;
    }

    // The same check the app makes after sign-in (isAllowedBuEmail), repeated where it can't be skipped.
    function isBuUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@bu[.]edu$');
    }

    function isMemberName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    function isValidNewPod(pod) {
      let minute = 60 * 1000;
      let length = pod.endsAt.toMillis() - pod.startsAt.toMillis();
      let fields = ['title', 'course', 'building', 'meetingPoint', 'startsAt', 'endsAt',
                    'capacity', 'hostUid', 'hostName', 'members', 'mode', 'canceled'];
      return pod.keys().hasOnly(fields) && pod.keys().hasAll(fields)
        && pod.title is string && pod.title.size() >= 3 && pod.title.size() <= 60
        && (pod.course == null || (pod.course is string && pod.course.size() <= 20))
        && pod.building is string && pod.building.size() >= 1 && pod.building.size() <= 80
        && pod.meetingPoint is string && pod.meetingPoint.size() >= 3 && pod.meetingPoint.size() <= 80
        && pod.startsAt is timestamp && pod.endsAt is timestamp
        && pod.endsAt > request.time
        && length >= 30 * minute && length <= 240 * minute
        && pod.startsAt.toMillis() <= request.time.toMillis() + 7 * 24 * 60 * minute
        && pod.capacity is int && pod.capacity >= 2 && pod.capacity <= 8
        && pod.hostUid == request.auth.uid
        && isMemberName(pod.hostName)
        && pod.members is map
        && pod.members.keys().hasOnly([request.auth.uid]) && pod.members.size() == 1
        && pod.members[request.auth.uid] == pod.hostName
        && pod.mode in ['QUIET', 'COORDINATE', 'TALK']
        && pod.canceled == false;
    }

    // Only members changes, and the only change is the user's own key being added.
    function isJoin(before, after) {
      let uid = request.auth.uid;
      let change = after.members.diff(before.members);
      return after.diff(before).affectedKeys().hasOnly(['members'])
        && change.addedKeys() == [uid].toSet()
        && change.removedKeys().size() == 0
        && change.changedKeys().size() == 0
        && isMemberName(after.members[uid])
        && after.members.size() <= before.capacity
        && before.canceled == false
        && request.time < before.endsAt - duration.value(10, 'm');
    }

    // Only members changes, and the only change is the user's own key being removed.
    function isLeave(before, after) {
      let uid = request.auth.uid;
      let change = after.members.diff(before.members);
      return after.diff(before).affectedKeys().hasOnly(['members'])
        && change.removedKeys() == [uid].toSet()
        && change.addedKeys().size() == 0
        && change.changedKeys().size() == 0
        && uid != before.hostUid;
    }

    // Only canceled changes, from false to true, by the host, before the end.
    function isCancel(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['canceled'])
        && before.canceled == false
        && after.canceled == true
        && request.auth.uid == before.hostUid
        && request.time < before.endsAt;
    }
  }
}

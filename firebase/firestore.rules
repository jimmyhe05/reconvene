rules_version = '2';

// Only signed-in users with a verified @bu.edu Google account can read or write pods.
// - Create: the creator must be the host and the only member. Or a group's host schedules the group's
//   proposal: the pod matches it, everyone who said they can come is in, and the same write clears it.
// - Update: a user may add or remove only themselves in members. Joining stops at capacity and
//   10 minutes before the end. The host can't leave.
// - Cancel: only the host, only canceled going from false to true, and only before the pod ends.
// - Delete: never. Hosts cancel instead, which keeps the pod on record.
//
// Field names and limits must match PodFields in FirestorePodMapping.kt, the limits in CreatePodForm.kt,
// and JOIN_CUTOFF and MEMBER_NAME_MAX in Pod.kt.
//
// Groups (GroupFields in FirestoreGroupMapping.kt, the rules in Group.kt). A group's id is its pod's id.
// - Read: people in the group or invited to it, and whoever kept it, so they learn it already exists.
// - Create: the pod's host, while the pod is running and not canceled, with someone else in it. The host
//   is the only member and everyone else in the pod is invited, under their names in the pod.
// - Update: one kind of change at a time, touching only its own fields, and never once the group is
//   disbanded or the semester is over. An invited user accepts or declines for themselves. A member
//   leaves for themselves, but the host can't; the host offers the role to a member, the host or that
//   member calls it off, and when that member accepts they become host and the old host leaves.
//   Only the host disbands, which marks the group and keeps it. Any member proposes the next session,
//   replacing the last proposal and its votes, and counts as coming; each member votes only for
//   themselves; leaving or handing over takes back the leaver's vote; only the host schedules it.
// - Delete: never.
//
// Group chat (MessageFields in FirestoreGroupMapping.kt, MESSAGE_MAX in Group.kt), in
// groups/{groupId}/messages. Members read it, including after the group is disbanded or archived;
// invited users don't until they accept. A member writes a message as themselves, under their name in
// the group, while it's open, stamped with the server's time. Messages are never changed or deleted.
//
// Reports (ReportFields in FirestoreGroupMapping.kt). A member reports another member's message in
// their group, once, with one of the reasons in ReportReason and the server's time. Only the reporter
// can read their own report, so whoever is reported never learns who it was. Never changed or deleted;
// the team reads them in the Firebase console.
//
// Blocks (BlockFields), in users/{uid}/blocked/{blockedUid}. Only that user reads or changes their own
// list, and can't block themselves. The blocked person is never told.
service cloud.firestore {
  match /databases/{database}/documents {

    match /pods/{podId} {
      allow read: if isBuUser();
      allow create: if isBuUser() && podId.size() <= 64
        && (isValidNewPod(request.resource.data)
            || (request.resource.data.get('groupId', null) is string
                && isScheduledPod(podId, request.resource.data)));
      allow update: if isBuUser() && (isJoin(resource.data, request.resource.data)
                                       || isLeave(resource.data, request.resource.data)
                                       || isCancel(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isBuUser()
        && (resource == null
            || request.auth.uid in resource.data.access
            || request.auth.uid == resource.data.keptByUid);
      allow create: if isBuUser() && isValidNewGroup(groupId, request.resource.data);
      allow update: if isBuUser() && isOpen(resource.data)
        && (isAcceptInvite(resource.data, request.resource.data)
            || isDeclineInvite(resource.data, request.resource.data)
            || isLeaveGroup(resource.data, request.resource.data)
            || isOfferHandover(resource.data, request.resource.data)
            || isWithdrawHandover(resource.data, request.resource.data)
            || isAcceptHandover(resource.data, request.resource.data)
            || isDisband(resource.data, request.resource.data)
            || isPropose(resource.data, request.resource.data)
            || isVote(resource.data, request.resource.data)
            || isSchedule(groupId, resource.data, request.resource.data));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isBuUser() && request.auth.uid in groupData(groupId).members;
        allow create: if isBuUser() && messageId.size() <= 64
          && isValidMessage(groupData(groupId), request.resource.data);
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      // A report that doesn't exist yet can be read, so the app can check before writing one.
      allow read: if isBuUser()
        && (resource == null || resource.data.reporterUid == request.auth.uid);
      allow create: if isBuUser() && isValidReport(reportId, request.resource.data);
      allow update, delete: if false;
    }

    match /users/{uid}/blocked/{blockedUid} {
      allow read, delete: if isBuUser() && request.auth.uid == uid;
      allow create, update: if isBuUser() && request.auth.uid == uid
        && blockedUid != uid && blockedUid.size() <= 128
        && isValidBlock(request.resource.data);
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isValidMessage(group, message) {
      let uid = request.auth.uid;
      let fields = ['authorUid', 'authorName', 'text', 'sentAt'];
      return message.keys().hasOnly(fields) && message.keys().hasAll(fields)
        && isOpen(group)
        && uid in group.members
        && message.authorUid == uid
        && message.authorName == group.members[uid]
        && message.text is string && message.text.size() <= 500
        && message.text.trim().size() >= 1
        && message.sentAt == request.time;
    }

    // The same check the app makes after sign-in (isAllowedBuEmail), repeated where it can't be skipped.
    function isBuUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@bu[.]edu$');
    }

    function isMemberName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    function isValidNewPod(pod) {
      let minute = 60 * 1000;
      let length = pod.endsAt.toMillis() - pod.startsAt.toMillis();
      let fields = ['title', 'course', 'building', 'meetingPoint', 'startsAt', 'endsAt',
                    'capacity', 'hostUid', 'hostName', 'members', 'mode', 'canceled'];
      // groupId is null on a pod made in Discover; builds from before it existed leave it out.
      return pod.keys().hasOnly(fields.concat(['groupId'])) && pod.keys().hasAll(fields)
        && pod.get('groupId', null) == null
        && pod.title is string && pod.title.size() >= 3 && pod.title.size() <= 60
        && (pod.course == null || (pod.course is string && pod.course.size() <= 20))
        && pod.building is string && pod.building.size() >= 1 && pod.building.size() <= 80
        && pod.meetingPoint is string && pod.meetingPoint.size() >= 3 && pod.meetingPoint.size() <= 80
        && pod.startsAt is timestamp && pod.endsAt is timestamp
        && pod.endsAt > request.time
        && length >= 30 * minute && length <= 240 * minute
        && pod.startsAt.toMillis() <= request.time.toMillis() + 7 * 24 * 60 * minute
        && pod.capacity is int && pod.capacity >= 2 && pod.capacity <= 50
        && pod.hostUid == request.auth.uid
        && isMemberName(pod.hostName)
        && pod.members is map
        && pod.members.keys().hasOnly([request.auth.uid]) && pod.members.size() == 1
        && pod.members[request.auth.uid] == pod.hostName
        && pod.mode in ['QUIET', 'TALK']
        && pod.canceled == false;
    }

    // Only members changes, and the only change is the user's own key being added.
    function isJoin(before, after) {
      let uid = request.auth.uid;
      let change = after.members.diff(before.members);
      return after.diff(before).affectedKeys().hasOnly(['members'])
        && change.addedKeys() == [uid].toSet()
        && change.removedKeys().size() == 0
        && change.changedKeys().size() == 0
        && isMemberName(after.members[uid])
        && after.members.size() <= before.capacity
        && before.canceled == false
        && request.time < before.endsAt - duration.value(10, 'm');
    }

    // Only members changes, and the only change is the user's own key being removed.
    function isLeave(before, after) {
      let uid = request.auth.uid;
      let change = after.members.diff(before.members);
      return after.diff(before).affectedKeys().hasOnly(['members'])
        && change.removedKeys() == [uid].toSet()
        && change.addedKeys().size() == 0
        && change.changedKeys().size() == 0
        && uid != before.hostUid;
    }

    // Only canceled changes, from false to true, by the host, before the end.
    function isCancel(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['canceled'])
        && before.canceled == false
        && after.canceled == true
        && request.auth.uid == before.hostUid
        && request.time < before.endsAt;
    }

    // Groups are read-only after the end of Dec 19, 2026 in Boston (SEMESTER_END in Group.kt).
    function semesterEnd() {
      return timestamp.value(1797742800000);
    }

    function isOpen(group) {
      return group.disbanded == false && request.time < group.archivesAt;
    }

    // after is before with only uid's key gone.
    function isRemovedKey(before, after, uid) {
      let change = after.diff(before);
      return change.removedKeys() == [uid].toSet()
        && change.addedKeys().size() == 0
        && change.changedKeys().size() == 0;
    }

    // after is before with only uid's key added.
    function isAddedKey(before, after, uid) {
      let change = after.diff(before);
      return change.addedKeys() == [uid].toSet()
        && change.removedKeys().size() == 0
        && change.changedKeys().size() == 0;
    }

    // access lost uid and nothing else.
    function isWithoutAccess(before, after, uid) {
      return uid in before.access
        && after.access.toSet() == before.access.toSet().difference([uid].toSet())
        && after.access.size() == before.access.size() - 1;
    }

    function isValidNewGroup(groupId, group) {
      let uid = request.auth.uid;
      let pod = get(/databases/$(database)/documents/pods/$(groupId)).data;
      // Compared with the pod's members, the invites are missing only the host and change no names.
      let invites = pod.members.diff(group.invited);
      let fields = ['name', 'course', 'fromPodId', 'hostUid', 'keptByUid', 'members', 'invited',
                    'access', 'handover', 'archivesAt', 'disbanded'];
      // proposal starts null; builds from before it existed leave it out.
      return group.keys().hasOnly(fields.concat(['proposal'])) && group.keys().hasAll(fields)
        && group.get('proposal', null) == null
        && group.name is string && group.name.size() >= 3 && group.name.size() <= 40
        && group.course == pod.course
        && group.fromPodId == groupId
        && group.hostUid == uid && group.keptByUid == uid
        && pod.hostUid == uid
        && pod.canceled == false
        && request.time >= pod.startsAt && request.time < pod.endsAt
        && pod.members.size() >= 2 && pod.members.size() <= 50
        && group.members is map && group.members.keys().hasOnly([uid]) && group.members.size() == 1
        && group.members[uid] == pod.members[uid]
        && group.invited is map
        && invites.addedKeys() == [uid].toSet()
        && invites.removedKeys().size() == 0
        && invites.changedKeys().size() == 0
        && group.access is list
        && group.access.toSet() == pod.members.keys().toSet()
        && group.access.size() == pod.members.size()
        && group.handover == null
        && group.archivesAt == semesterEnd()
        && request.time < semesterEnd()
        && group.disbanded == false;
    }

    // An invited user moves themselves from invited to members, under the same name.
    function isAcceptInvite(before, after) {
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['members', 'invited'])
        && isRemovedKey(before.invited, after.invited, uid)
        && isAddedKey(before.members, after.members, uid)
        && after.members[uid] == before.invited[uid];
    }

    // An invited user takes themselves out of invited and access.
    function isDeclineInvite(before, after) {
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['invited', 'access'])
        && isRemovedKey(before.invited, after.invited, uid)
        && isWithoutAccess(before, after, uid);
    }

    // A member other than the host takes themselves out. A handover offered to them is called off too,
    // and their vote is taken back.
    function isLeaveGroup(before, after) {
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['members', 'access', 'handover', 'proposal'])
        && uid != before.hostUid
        && isRemovedKey(before.members, after.members, uid)
        && isWithoutAccess(before, after, uid)
        && isWithoutVote(before, after, uid)
        && (after.handover == before.handover
            || (before.handover != null && before.handover.uid == uid && after.handover == null));
    }

    // The host offers the role to another member, under their name in the group.
    function isOfferHandover(before, after) {
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['handover'])
        && uid == before.hostUid
        && after.handover is map
        && after.handover.keys().hasOnly(['uid', 'name']) && after.handover.keys().hasAll(['uid', 'name'])
        && after.handover.uid != uid
        && after.handover.uid in before.members
        && after.handover.name == before.members[after.handover.uid];
    }

    // The host takes the offer back, or the member it was made to says no.
    function isWithdrawHandover(before, after) {
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['handover'])
        && before.handover != null
        && after.handover == null
        && (uid == before.hostUid || uid == before.handover.uid);
    }

    // The member offered the role takes it, and the old host leaves in the same write, vote and all.
    function isAcceptHandover(before, after) {
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['hostUid', 'handover', 'members', 'access', 'proposal'])
        && isWithoutVote(before, after, before.hostUid)
        && before.handover != null
        && before.handover.uid == uid
        && after.hostUid == uid
        && after.handover == null
        && isRemovedKey(before.members, after.members, before.hostUid)
        && isWithoutAccess(before, after, before.hostUid);
    }

    // Only the host, marking the group disbanded at the server's time.
    function isDisband(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['disbanded', 'disbandedAt'])
        && request.auth.uid == before.hostUid
        && after.disbanded == true
        && after.disbandedAt == request.time;
    }

    // The reporter is a member of the group, and the person reported wrote the message and isn't them.
    function isValidReport(reportId, report) {
      let uid = request.auth.uid;
      let fields = ['groupId', 'messageId', 'reporterUid', 'targetUid', 'reason', 'createdAt'];
      let message = get(/databases/$(database)/documents/groups/$(report.groupId)/messages/$(report.messageId)).data;
      return report.keys().hasOnly(fields) && report.keys().hasAll(fields)
        && report.reporterUid == uid
        && reportId == report.messageId + '_' + uid
        && uid in groupData(report.groupId).members
        && message.authorUid == report.targetUid
        && report.targetUid != uid
        && report.reason in ['HARASSMENT', 'SPAM', 'ACADEMIC_DISHONESTY', 'UNSAFE_MEETUP', 'OTHER']
        && report.createdAt == request.time;
    }

    function isValidBlock(block) {
      return block.keys().hasOnly(['name', 'blockedAt']) && block.keys().hasAll(['name', 'blockedAt'])
        && isMemberName(block.name)
        && block.blockedAt == request.time;
    }

    // No proposal, or the same one with uid's vote gone (or never there), so someone who's left can't
    // count toward scheduling.
    function isWithoutVote(before, after, uid) {
      let was = before.get('proposal', null);
      let now = after.get('proposal', null);
      return (was == null && now == null)
        || (was != null && now != null
            && now.diff(was).affectedKeys().hasOnly(['yes', 'no'])
            && now.yes.diff(was.yes).affectedKeys().hasOnly([uid]) && !(uid in now.yes)
            && now.no.diff(was.no).affectedKeys().hasOnly([uid]) && !(uid in now.no));
    }

    // A member suggests the next session, with the same limits as a new pod, and counts as coming.
    // It replaces any earlier proposal and its votes. Its id becomes the pod's, so it can't be taken.
    function isPropose(before, after) {
      let uid = request.auth.uid;
      let proposal = after.proposal;
      let minute = 60 * 1000;
      let fields = ['id', 'startsAt', 'endsAt', 'building', 'meetingPoint', 'mode', 'byUid', 'yes', 'no'];
      return after.diff(before).affectedKeys().hasOnly(['proposal'])
        && uid in before.members
        && proposal is map
        && proposal.keys().hasOnly(fields) && proposal.keys().hasAll(fields)
        && proposal.id is string && proposal.id.size() >= 1 && proposal.id.size() <= 64
        && !exists(/databases/$(database)/documents/pods/$(proposal.id))
        && proposal.startsAt is timestamp && proposal.endsAt is timestamp
        && proposal.endsAt > request.time
        && proposal.endsAt.toMillis() - proposal.startsAt.toMillis() >= 30 * minute
        && proposal.endsAt.toMillis() - proposal.startsAt.toMillis() <= 240 * minute
        && proposal.startsAt.toMillis() <= request.time.toMillis() + 7 * 24 * 60 * minute
        && proposal.building is string && proposal.building.size() >= 1 && proposal.building.size() <= 80
        && proposal.meetingPoint is string && proposal.meetingPoint.size() >= 3 && proposal.meetingPoint.size() <= 80
        && proposal.mode in ['QUIET', 'TALK']
        && proposal.byUid == uid
        && proposal.yes is map && proposal.yes.keys().hasOnly([uid]) && proposal.yes.size() == 1
        && proposal.yes[uid] == before.members[uid]
        && proposal.no is map && proposal.no.size() == 0;
    }

    // A member says they can or can't come to the proposal while it hasn't ended, changing only their
    // own vote, under their name in the group.
    function isVote(before, after) {
      let uid = request.auth.uid;
      let was = before.get('proposal', null);
      let now = after.proposal;
      return after.diff(before).affectedKeys().hasOnly(['proposal'])
        && uid in before.members
        && was != null && now is map
        && was.endsAt > request.time
        && now.diff(was).affectedKeys().hasOnly(['yes', 'no'])
        && now.yes.diff(was.yes).affectedKeys().hasOnly([uid])
        && now.no.diff(was.no).affectedKeys().hasOnly([uid])
        && ((uid in now.yes && now.yes[uid] == before.members[uid] && !(uid in now.no))
            || (uid in now.no && now.no[uid] == true && !(uid in now.yes)));
    }

    // The host clears the proposal in the same write that makes its pod (isScheduledPod).
    function isSchedule(groupId, before, after) {
      let was = before.get('proposal', null);
      let podPath = /databases/$(database)/documents/pods/$(was.id);
      return after.diff(before).affectedKeys().hasOnly(['proposal'])
        && request.auth.uid == before.hostUid
        && was != null && after.proposal == null
        && existsAfter(podPath)
        && getAfter(podPath).data.get('groupId', null) == groupId;
    }

    // The pod a group's host makes from the group's proposal: its time, place and vibe, the group's
    // name and course, and the host plus everyone who said they can come, at least two. The same
    // write clears the proposal, so it's scheduled once.
    function isScheduledPod(podId, pod) {
      let uid = request.auth.uid;
      let groupPath = /databases/$(database)/documents/groups/$(pod.groupId);
      let group = get(groupPath).data;
      let proposal = group.get('proposal', null);
      // Compared with who said yes, the members add at most the host and change no names.
      let going = pod.members.diff(proposal.yes);
      let fields = ['title', 'course', 'building', 'meetingPoint', 'startsAt', 'endsAt',
                    'capacity', 'hostUid', 'hostName', 'members', 'mode', 'canceled', 'groupId'];
      return pod.keys().hasOnly(fields) && pod.keys().hasAll(fields)
        && isOpen(group)
        && group.hostUid == uid
        && proposal != null && proposal.id == podId
        && getAfter(groupPath).data.get('proposal', null) == null
        && pod.title == group.name && pod.course == group.course
        && pod.building == proposal.building && pod.meetingPoint == proposal.meetingPoint
        && pod.startsAt == proposal.startsAt && pod.endsAt == proposal.endsAt
        && pod.endsAt > request.time
        && pod.mode == proposal.mode
        && pod.hostUid == uid && pod.hostName == group.members[uid]
        && pod.members is map
        && pod.members[uid] == group.members[uid]
        && going.addedKeys().hasOnly([uid])
        && going.removedKeys().size() == 0
        && going.changedKeys().size() == 0
        && pod.members.size() >= 2
        && pod.capacity is int && pod.capacity >= pod.members.size() && pod.capacity <= 50
        && pod.canceled == false;
    }
  }
}
